---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Submit Your Game for a Leak Review — FM Dalton Perrine"
  description="Submit your game to FM Dalton Perrine for a leak review."
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content="0; url=https://forms.gle/arNhengLj1BXGU958" />
  </Fragment>

  <section class="bg-navy relative overflow-hidden min-h-[60vh] flex items-center justify-center">
    <div
      aria-hidden="true"
      class="absolute inset-0 opacity-[0.035] pointer-events-none"
      style="background-image: repeating-conic-gradient(#fff 0% 25%, transparent 0% 50%); background-size: 72px 72px;"
    ></div>
    <div class="relative text-center px-4">
      <p class="font-inter text-gold text-sm font-semibold tracking-widest uppercase mb-4">Redirecting…</p>
      <h1 class="font-playfair text-white text-4xl sm:text-5xl font-bold mb-6">Leak Review</h1>
      <p class="font-inter text-off-white/70 text-lg mb-8">
        You're being redirected to the game submission form.
      </p>
      <a
        href="https://forms.gle/arNhengLj1BXGU958"
        class="btn-gold text-base px-8 py-3.5"
      >
        Open Submission Form
      </a>
    </div>
  </section>
</Layout>
