---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="1.e4 Course Waitlist: Ruy Lopez and Anti-Sicilians — FM Dalton Perrine"
  description="Join the waitlist for the 1.e4 course covering the Ruy Lopez and Anti-Sicilians with FM Dalton Perrine."
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content="0; url=https://forms.gle/1n2iPmVgRZNc9Wgj6" />
  </Fragment>

  <section class="bg-navy relative overflow-hidden min-h-[60vh] flex items-center justify-center">
    <div
      aria-hidden="true"
      class="absolute inset-0 opacity-[0.035] pointer-events-none"
      style="background-image: repeating-conic-gradient(#fff 0% 25%, transparent 0% 50%); background-size: 72px 72px;"
    ></div>
    <div class="relative text-center px-4">
      <p class="font-inter text-gold text-sm font-semibold tracking-widest uppercase mb-4">Redirecting…</p>
      <h1 class="font-playfair text-white text-4xl sm:text-5xl font-bold mb-6">1.e4 Course Waitlist</h1>
      <p class="font-inter text-off-white/70 text-lg mb-8">
        You're being redirected to the waitlist form.
      </p>
      <a
        href="https://forms.gle/1n2iPmVgRZNc9Wgj6"
        class="btn-gold text-base px-8 py-3.5"
      >
        Open Waitlist Form
      </a>
    </div>
  </section>
</Layout>
