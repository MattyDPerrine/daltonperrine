---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Apply for Coaching — FM Dalton Perrine"
  description="Apply to work with FM Dalton Perrine for 1-on-1 online chess coaching."
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content="0; url=https://forms.gle/3tr1WTL8jQ3NnK1D6" />
  </Fragment>

  <section class="bg-navy relative overflow-hidden min-h-[60vh] flex items-center justify-center">
    <div
      aria-hidden="true"
      class="absolute inset-0 opacity-[0.035] pointer-events-none"
      style="background-image: repeating-conic-gradient(#fff 0% 25%, transparent 0% 50%); background-size: 72px 72px;"
    ></div>
    <div class="relative text-center px-4">
      <p class="font-inter text-gold text-sm font-semibold tracking-widest uppercase mb-4">Redirecting…</p>
      <h1 class="font-playfair text-white text-4xl sm:text-5xl font-bold mb-6">Coaching Application</h1>
      <p class="font-inter text-off-white/70 text-lg mb-8">
        You're being redirected to the application form.
      </p>
      <a
        href="https://forms.gle/3tr1WTL8jQ3NnK1D6"
        class="btn-gold text-base px-8 py-3.5"
      >
        Open Application Form
      </a>
    </div>
  </section>
</Layout>
